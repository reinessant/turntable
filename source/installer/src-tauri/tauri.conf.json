{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turntable Setup",
  "mainBinaryName": "turntable-setup",
  "version": "0.1.4",
  "identifier": "app.turntable.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Turntable Setup",
        "width": 940,
        "height": 600,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
