{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turntable",
  "version": "0.1.2",
  "identifier": "app.turntable.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Turntable",
        "width": 1440,
        "height": 860,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data: https://*.sndcdn.com; media-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://lrclib.net; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA",
          "$APPDATA/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "publisher": "Turntable",
    "copyright": "© 2026 Turntable",
    "category": "Music",
    "shortDescription": "A tactile local album player",
    "longDescription": "Turntable plays your local albums on a virtual record player: crate, deck, plugins, synced lyrics and a pocket cassette mini player.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  }
}
